# Settings for `docker compose up`. Copy to .env and edit.

ENVIRONMENT=production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-me-with-a-long-random-string
POSTGRES_PASSWORD=change-this-password

# The public address of the site (used in password-reset links and CORS)
APP_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080

# "live" = real Kalshi data, "mock" = built-in sample markets
KALSHI_MODE=live

# Email for password resets (any SMTP provider). Leave SMTP_HOST empty to log emails instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Fomoshi <no-reply@your-domain.com>

# Optional error tracking
SENTRY_DSN=
