# Local development settings. Copy to backend/.env.

ENVIRONMENT=development

# "live" pulls real data from Kalshi's public API; "mock" serves app/kalshi/fixtures
KALSHI_MODE=live
KALSHI_BASE_URL=https://external-api.kalshi.com/trade-api/v2

# SQLite is fine locally. Production needs Postgres: postgresql://user:pass@host:5432/fomoshi
DATABASE_URL=sqlite:///./fomoshi.db
# Optional locally; shared cache + rate limits across processes
REDIS_URL=

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-key-change-me

# The worker (catalog sync, settlement, equity snapshots) runs inside the API in dev
RUN_WORKER_IN_PROCESS=true
SETTLEMENT_INTERVAL_SECONDS=60
MARKET_SYNC_INTERVAL_SECONDS=300

STARTING_CASH=1000
APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Password-reset email. Without SMTP_HOST, emails are printed to the API log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Fomoshi <no-reply@localhost>

SENTRY_DSN=
