# "live" pulls real data from Kalshi's public API; "mock" serves the sample data in app/kalshi/fixtures
KALSHI_MODE=live
KALSHI_BASE_URL=https://external-api.kalshi.com/trade-api/v2

# SQLite by default. For Postgres: postgresql+psycopg://user:pass@localhost:5432/fomoshi
DATABASE_URL=sqlite:///./fomoshi.db

# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
ACCESS_TOKEN_MINUTES=10080

STARTING_CASH=1000
SETTLEMENT_INTERVAL_SECONDS=60
CORS_ORIGINS=http://localhost:5173
